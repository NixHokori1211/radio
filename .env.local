# Configurações da API
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=ws://localhost:5000

# Configurações do Player
VITE_DEFAULT_VOLUME=0.7
VITE_MAX_PLAYLIST_SIZE=50

# Integração com Discord (para desenvolvimento)
VITE_DISCORD_CLIENT_ID=your_dev_client_id
VITE_DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Chaves de Desenvolvimento
VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXX-X
VITE_SENTRY_DSN=https://example@sentry.io/12345

# Modo Debug
VITE_DEBUG_MODE=true
VITE_LOG_NETWORK_REQUESTS=true

# Feature Flags (Habilitar/desabilitar funcionalidades)
VITE_FEATURE_RADIO_3D=true
VITE_FEATURE_AR_MODE=false
VITE_FEATURE_PREMIUM_CONTENT=false

# Configurações Específicas do Modo Retrô
VITE_RETRO_MODE_DEFAULT=false
VITE_RETRO_EFFECTS_INTENSITY=0.8

# Limites do Sistema de Pontos
VITE_POINTS_PER_MINUTE=1
VITE_POINTS_RETRO_BONUS=2
VITE_MAX_DAILY_POINTS=500

# URLs de Stream (Desenvolvimento)
VITE_RADIO_STREAM_URL_1=http://dev.stream.hutao-radio.com/main
VITE_RADIO_STREAM_URL_2=http://dev.stream.hutao-radio.com/retro